# Required
OPENAI_API_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Required when NODE_ENV=production: number of trusted reverse-proxy hops, or false.
NODE_ENV=development
TRUST_PROXY=false

# Optional (defaults shown)
PORT=3000
# Comma-separated browser origins; leave empty for native-app-only access.
CORS_ORIGINS=
MIGRATE_ON_START=true
DATABASE_POOL_MAX=10
JSON_BODY_LIMIT_BYTES=26214400
MAX_SKETCH_BYTES=16777216
MAX_PROMPT_CHARS=4000
OPENAI_TIMEOUT_MS=180000
JOB_TIMEOUT_MS=300000
JOB_LEASE_MS=90000
IMAGE_RETENTION_HOURS=24
RECORD_RETENTION_DAYS=30
USAGE_RETENTION_DAYS=90
AUTH_RATE_LIMIT_PER_HOUR=20
START_RATE_LIMIT_PER_10_MIN=30
READ_RATE_LIMIT_PER_5_MIN=600
IP_RATE_LIMIT_PER_5_MIN=1200
